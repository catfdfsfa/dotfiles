{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "green"
    }
  },
  "modules": [
    "title",
    "separator",
    { "type": "host",     "key": "\uf108  Host" },
    { "type": "os",       "key": "\uf303  OS" },
    { "type": "wm",       "key": "\uf2d0  WM" },
    { "type": "terminal", "key": "\uf120  Term" },
    { "type": "shell",    "key": "\uf489  Shell" },
    "break",
    {
        "type": "command",
        "key": "OS Age",
        "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },
    "uptime",
    "break",
    { "type": "memory",   "key": "\uefc5  RAM" },
    { "type": "cpu",      "key": "\uf4bc  CPU" },
    { "type": "gpu",      "key": "\uf26c  GPU" },
    "separator",
    "colors"
  ]
}
