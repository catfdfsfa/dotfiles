	name = catfdfsfa
	email = catfdfsfa@proton.me 
[init]
    defaultBranch = main
[alias]
	st = status -s
	lg = log --graph --oneline
	amend = commit --amend --no-edit
	pushf = push --force-with-lease
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[fetch]
	prune = true
[commit]
	cleanup = scissors
[color "status"]
	changed = yellow
